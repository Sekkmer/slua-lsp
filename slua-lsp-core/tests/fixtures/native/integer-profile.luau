-- Safe local profile qualification: no host/world APIs.
assert(type(integer) == "table")
assert(number == nil)
local ok = pcall(function() return integer(1) end)
assert(not ok)
local whole = integer.create(42)
assert(typeof(whole) == "integer")
assert(integer.tonumber(whole) == 42)
assert(integer.create(1.5) == nil)
assert(integer.create(math.huge) == nil)
assert(integer.create(9223372036854775808) == nil)
assert(integer.create(-9223372036854775808) == integer.minsigned)
assert(integer.fromstring("bad") == nil)
assert(integer.tonumber(integer.fromstring("ff", 16)) == 255)
assert(integer.add(integer.maxsigned, integer.create(1)) == integer.minsigned)
assert(integer.tonumber(integer.div(integer.create(-7), integer.create(2))) == -3)
assert(integer.tonumber(integer.idiv(integer.create(-7), integer.create(2))) == -4)
local acceptsNumber = pcall(function() return integer.add(1, 2) end)
assert(not acceptsNumber)
assert(math.abs(whole) == 42)
assert(tonumber(whole) == 42)
assert(integer.band() == integer.create(-1))
assert(integer.bor() == integer.create(0))
assert(integer.btest())
assert(integer.min(whole) == whole)
assert(integer.max(integer.minsigned, whole, integer.maxsigned) == integer.maxsigned)
assert(not pcall(function() return integer.band(whole, whole, 1) end))
print("integer profile passed", type(whole), typeof(whole))
local names = {}
for name in integer do table.insert(names, name) end
table.sort(names)
print(table.concat(names, ","))
